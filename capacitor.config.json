{
  "appId": "com.gradetrackpro.app",
  "appName": "GradeTrackPro",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0ea5e9",
      "showSpinner": false
    }
  }
}
